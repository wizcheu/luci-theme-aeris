{% include('header', { blank_page: true }) %}
<main class="aeris-login">
 <div class="aeris-login-brand"><span class="aeris-mark" aria-hidden="true"></span><span>Aeris<span class="aeris-muted">.</span></span></div>
 <section class="aeris-login-card" aria-labelledby="aeris-login-title">
  <h1 id="aeris-login-title">{{ _('Welcome back!') }}</h1>
  <p>{{ _('Please enter your username and password.') }}</p>
  {% if (fuser): %}<div class="alert-message error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>{% endif %}
  <form method="post">
   <label for="luci_username">{{ _('Username') }}</label>
   <input id="luci_username" name="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}" required>
   <label for="luci_password">{{ _('Password') }}</label>
   <div class="control-group"><input id="luci_password" name="luci_password" type="password" autocomplete="current-password" autofocus><button type="button" class="cbi-button" data-aeris-password aria-label="{{ _('Show password') }}"><svg class="ae-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button></div>
   <button class="btn cbi-button-apply" type="submit">{{ _('Log in') }}</button>
  </form>
 </section>
 <p class="aeris-login-footer">{{ version.distname }} {{ version.distversion }}</p>
</main>
{% include('footer', { blank_page: true }) %}
